# 실제 사용 시 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env

# 답변 생성 LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# 임베딩 (OpenAI) - Anthropic은 임베딩 API를 제공하지 않아 별도 키가 필요합니다.
OPENAI_API_KEY=sk-proj-...

# --- 아래는 전부 선택값이며, 미설정 시 config.py 의 기본값이 사용됩니다 ---
# JOBRADAR_DATA_DIR=
# JOBRADAR_STORAGE_DIR=
# JOBRADAR_CHUNK_SIZE=800
# JOBRADAR_CHUNK_OVERLAP=120
# JOBRADAR_TOP_K=4
